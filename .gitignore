# raw source pulls are reproducible via pipeline/fetch_*.py — keep out of git
data/raw/

# dictpress runtime (binary + theme from upstream release) and generated DB
dictpress/app/
dictpress/data.db
dictpress/data.db-*

# large generated corpora (regenerate from data/raw)
data/corpus/
data/training/sft*.jsonl

.DS_Store
__pycache__/
.venv/
data/lid/model.joblib

# deployment: secrets, generated config, live databases, backups
deploy/.env
deploy/config.prod.toml
deploy/data/
deploy/backups/

# server-side artefacts
dictpress/config.prod.toml
deploy/setup.log
deploy/publish.log
deploy/setup-trace.log
deploy/.*.swp

