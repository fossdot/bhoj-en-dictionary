# Copy to deploy/.env and fill in. Never commit .env.

# Domains — create DNS A records for both pointing at the server's IP first.
DICT_DOMAIN=bhoj.example.org
REVIEW_DOMAIN=review.bhoj.example.org

# dictpress admin (http://DICT_DOMAIN/admin). Pick a long password.
DICT_ADMIN_USER=admin
DICT_ADMIN_PASSWORD=change-me-to-something-long

# Review app
REVIEW_INVITE_CODE=change-me-class-code
REVIEW_SECRET_KEY=change-me-run-openssl-rand-hex-32
REVIEW_PHASE=1
REVIEW_VERIFY_VOTES=1
REVIEW_DELETE_VOTES=2
REVIEW_BATCH_SIZE=100
DICT_URL=https://bhoj.example.org
